# ============================================================
# ERP Multiempresa - Variables de entorno (EJEMPLO)
# Copia este archivo a .env y completa los valores reales.
# NUNCA subas .env al repositorio.
# ============================================================

# --- Entorno ---
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# --- Base de datos (MongoDB Atlas) ---

# URI de ejemplo. Sustituye usuario, contraseña, cluster y base por los del entorno.
MONGO_URI=
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/erp?retryWrites=true&w=majority
MONGODB_USERNAME=USER
MONGODB_PASSWORD=PASSWORD

# --- Seguridad ---
# Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=cambie-este-secreto-largo-aleatorio-ACCESS
JWT_REFRESH_SECRET=cambie-este-secreto-largo-aleatorio-REFRESH
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# CORS: orígenes permitidos, separados por coma (web)
CORS_ORIGINS=http://localhost:19006,http://localhost:8081

# --- Frontend (Expo / React Native Web) ---
# URL base de la API para el cliente
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1

# --- Semilla inicial ---
# Email y clave del Super Admin creado por `npm run seed` (solo primera vez)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=CambiarClave123!

# --- Logging ---
LOG_LEVEL=info
